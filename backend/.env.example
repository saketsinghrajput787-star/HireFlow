# HireFlow Backend Environment Configuration Example
# Copy this file to .env and replace placeholder values with your real configuration.
# NEVER commit the real .env file or production keys to version control.

# Supabase Project Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Server-Side Service Role Key
# ONLY used by backend to look up authoritative user profile and role in the database.
# NEVER expose this key to the frontend client!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated list for Vite frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
