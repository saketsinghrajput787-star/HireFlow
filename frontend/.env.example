# HireFlow Frontend Environment Configuration
# Copy this file to .env.local and replace with your actual configuration values.
# NEVER commit your real .env.local to Git.

# FastAPI Backend URL
VITE_API_BASE_URL=http://localhost:8000

# Supabase Client Configuration (Safe for browser / public)
# Obtain from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# NOTE: Never add the SUPABASE_SERVICE_ROLE_KEY to the frontend!
